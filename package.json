{
  "name": "portfolio-react",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "cross-env NODE_ENV=development node --conditions development server.js",
    "start": "node server.js",
    "typecheck": "react-router typegen && tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test e2e/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@react-router/express": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "isbot": "^5.1.36",
    "morgan": "^1.10.1",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@playwright/test": "^1.56.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/morgan": "^1.9.10",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "cross-env": "^10.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.8"
